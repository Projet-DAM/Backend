  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/main.js",
    "start:dev": "tsc --project tsconfig.build.json --watch & node --watch dist/main.js",
    "start:debug": "tsc --project tsconfig.build.json --watch & node --inspect --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:whatsapp": "ts-node -r tsconfig-paths/register src/test-whatsapp.ts",
    "seed:coach-children": "ts-node -r tsconfig-paths/register src/seed-coach-children.ts",
    "update:children-coach": "ts-node -r tsconfig-paths/register src/update-children-coach.ts"
  },
