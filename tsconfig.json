{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDecoratorsLegacy": true,

    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
