# Port du serveur
PORT=3000

# Configuration MongoDB
# URI de connexion MongoDB (local ou MongoDB Atlas)
# Pour MongoDB local: mongodb://localhost:27017/sportyconnect
# Pour MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sportyconnect
MONGO_URI=mongodb://localhost:27017/sportyconnect

# Configuration JWT
# ClÃ© secrÃ¨te pour signer les tokens JWT (changez en production !)
# GÃ©nÃ©rer une clÃ© sÃ©curisÃ©e: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production

# DurÃ©e de validitÃ© du token JWT
# Formats acceptÃ©s: 1d (1 jour), 24h (24 heures), 3600s (1 heure), 7d (7 jours)
JWT_EXPIRES_IN=1d